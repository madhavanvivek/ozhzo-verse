# ==============================================================================
# Ozhzo Verse — Master Environment Variables Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Web Client Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Ozhzo Verse"

# Security & Cryptography
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Primary PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ozhzo_verse
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ozhzo_verse
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ozhzo_verse

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ozhzo-verse-media
STORAGE_REGION=us-east-1

# Transactional Email (SES / Resend / SMTP)
EMAIL_SENDER_ADDRESS=no-reply@ozhzoverse.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Stripe Billing (Subscription Foundation)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLIC_KEY=pk_test_placeholder
